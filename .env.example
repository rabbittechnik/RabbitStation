NODE_ENV=development
APP_NAME=RabbitStation Pro
PORT=3001
HOST=127.0.0.1

# Datenbank (SQLite lokal, PostgreSQL in Produktion)
DATABASE_PATH=./data/demo.sqlite
DATABASE_URL=

# JWT – in Produktion stark setzen
JWT_SECRET=CHANGE_ME_DEMO_SECRET_MIN_32_CHARS

# Demo-Admin (optional)
DEMO_ADMIN_PASSWORD=DemoRS2026!Local
DEMO_ADMIN_USERNAME=admin
SEED_DEMO=1

# E-Mail (keine echten Zugangsdaten committen)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=RabbitStation Pro
MAIL_FROM_ADDRESS=
# Legacy-Alias (optional, falls MAIL_FROM_ADDRESS leer)
SMTP_FROM=

# Öffentliche App-URL für Links in E-Mails (Setup, Login)
PUBLIC_APP_URL=http://localhost:5173

# Zahlung (später)
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
WEBHOOK_SECRET=

# Upload / Storage
UPLOAD_STORAGE_PROVIDER=local
BACKUP_PATH=

# CORS (kommagetrennt)
CLIENT_ORIGIN=http://localhost:5173
