NODE_ENV=development
APP_NAME=RabbitStation Pro
PORT=3001
HOST=127.0.0.1

# Lokale Demo-Datenbank (keine Echtdaten)
DATABASE_PATH=./data/demo.sqlite

# JWT / Session – in Produktion stark setzen
JWT_SECRET=CHANGE_ME_DEMO_SECRET_MIN_32_CHARS

# Demo-Admin (optional überschreiben)
DEMO_ADMIN_PASSWORD=DemoRS2026!Local
DEMO_ADMIN_USERNAME=admin

# Leer lassen in der Entwicklungskopie
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
WEBHOOK_SECRET=
SUMUP_API_KEY=
RAILWAY_TOKEN=

# Demo-Seed bei leerer DB (Standard in development: an)
SEED_DEMO=1
