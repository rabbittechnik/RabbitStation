NODE_ENV=development
APP_NAME=RabbitStation Pro
PORT=3001
HOST=127.0.0.1

# Datenbank (lokal: ./data/rabbitstation.db; Railway Production: /data/rabbitstation.db)
DATABASE_PATH=./data/rabbitstation.db
DATABASE_URL=

# JWT – in Produktion stark setzen
JWT_SECRET=CHANGE_ME_DEMO_SECRET_MIN_32_CHARS

# Demo-Admin (optional)
DEMO_ADMIN_PASSWORD=DemoRS2026!Local
DEMO_ADMIN_USERNAME=admin
# Demo-Seeding (lokal standardmäßig aktiv; Production: DEMO_SEED_ENABLED=false)
DEMO_SEED_ENABLED=
SEED_DEMO=1

# E-Mail (keine echten Zugangsdaten committen)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=RabbitStation Pro
MAIL_FROM_ADDRESS=
# Legacy-Alias (optional, falls MAIL_FROM_ADDRESS leer)
SMTP_FROM=

# Öffentliche App-URL für Links in E-Mails (Setup, Login) und CORS
PUBLIC_APP_URL=http://localhost:5173

# Optional: separates API-Host (sonst Production: relativer Pfad /api)
# VITE_API_URL=http://localhost:3001

# Zahlung (später)
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
WEBHOOK_SECRET=

# Upload / Storage
UPLOAD_STORAGE_PROVIDER=local
BACKUP_PATH=

# CORS (kommagetrennt)
CLIENT_ORIGIN=http://localhost:5173

# RabbitStation Control Center (Server-to-Server, nur Backend)
# Gleicher Wert muss im Control-Center-Service als CONTROL_CENTER_API_TOKEN gesetzt sein.
CONTROL_CENTER_API_TOKEN=

# Produktion: API + gebautes Frontend aus einem Prozess (server startet mit client/dist)
# Railway client-production: 1 (Express liefert client/dist + /api)
SERVE_CLIENT_STATIC=0
