{
  "name": "neonshift-station",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev:client",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w client && npm run build -w server",
    "build:client": "npm run build -w client",
    "build:server": "npm run build -w server",
    "preview:client": "npm run preview -w client",
    "serve:client": "npm run start -w client",
    "start": "npm run start -w client",
    "test": "tsx --test server/src/constants/plans.test.ts server/src/services/planFeatureService.test.ts server/src/routes/supportSession.api.test.ts client/src/data/pricingPlans.test.ts client/src/components/onboarding/tourPosition.test.ts"
  }
}
